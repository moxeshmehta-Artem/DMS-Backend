# DMS Environment Variables Template
# Copy this file to .env and fill in the values for production deployment

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/DMS-DB?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root123

# JWT Configuration 
# Generate a strong secret key for production (at least 64 characters)
JWT_SECRET=DMSSecretKeyForJWTTokenGenerationWhichShouldBeLongEnoughToMeetRequirements
JWT_EXPIRATION_MS=86400000
